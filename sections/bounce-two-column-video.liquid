{%- comment -%}
  Bounce two column video: a list of icon + text rows with a button underneath on the left,
  a video on the right. The video is a file uploaded to Shopify (MP4 or WebM); YouTube and
  Vimeo embeds aren't supported. Only Item blocks can be added. No JS; styles in
  src/scss/sections/_two-column-video.scss.

  Icons are theme assets (assets/bounce-icon-*.svg) inlined with inline_asset_content, so they
  inherit currentColor and recolour inside a section with its own text colour. A theme setting
  can't deliver an SVG: image_picker feeds image_url/image_tag, which don't process SVG.
{%- endcomment -%}

{%- liquid
  case section.settings.width
    when 'narrow'
      assign container_class = 'content-max content-max--narrow'
    when 'full'
      assign container_class = ''
    else
      assign container_class = 'content-max'
  endcase

  assign show_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_button = true
  endif
-%}

<div
  class="bounce-two-column-video spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="content-block">
    <div class="{{ container_class }}">
      <div class="bounce-two-column-video__grid">
        <div class="bounce-two-column-video__col-list">
          {%- if section.blocks.size > 0 -%}
            <ul class="bounce-two-column-video__list" role="list">
              {%- for block in section.blocks -%}
                <li
                  class="bounce-two-column-video__row"
                  {% render 'bounce-fade-attributes', settings: section.settings %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.icon != 'none' -%}
                    <span class="bounce-two-column-video__icon svg-wrapper" aria-hidden="true">
                      {{- block.settings.icon
                        | prepend: 'bounce-icon-'
                        | append: '.svg'
                        | inline_asset_content
                      -}}
                    </span>
                  {%- endif -%}
                  <span class="bounce-two-column-video__text">{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if show_button -%}
            <a
              href="{{ section.settings.button_link }}"
              class="button bounce-two-column-video__button"
              {% render 'bounce-fade-attributes', settings: section.settings %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <div
          class="bounce-two-column-video__col-media"
          {% render 'bounce-fade-attributes', settings: section.settings %}
        >
          {% render 'video',
            video: section.settings.video,
            video_class: 'bounce-two-column-video__media',
            video_autoplay: section.settings.video_autoplay,
            video_loop: section.settings.video_loop
          %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bounce two column video",
  "class": "bounce-two-column-video-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:settings.icon",
          "options": [
            {
              "value": "none",
              "label": "t:options.none"
            },
            {
              "value": "no-sugar",
              "label": "Senza zuccheri"
            },
            {
              "value": "no-sweeteners",
              "label": "Senza edulcoranti"
            },
            {
              "value": "no-gluten",
              "label": "Senza glutine"
            },
            {
              "value": "no-calories",
              "label": "Senza calorie"
            },
            {
              "value": "no-carbs",
              "label": "Senza carboidrati"
            },
            {
              "value": "no-artificial-flavours",
              "label": "Senza aromi artificiali"
            }
          ],
          "default": "no-sugar"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:settings.animation"
    },
    {
      "type": "checkbox",
      "id": "fade_up",
      "label": "Fade up on scroll",
      "info": "Each row, then the button and the video, fades in on its own as it scrolls into view.",
      "default": false
    },
    {
      "type": "range",
      "id": "fade_up_delay",
      "label": "Fade up delay",
      "info": "Seconds to wait before fading in. Give later items a higher delay (e.g. heading 0, button 0.2) so they arrive one after another.",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "unit": "s",
      "default": 0,
      "visible_if": "{{ section.settings.fade_up }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "page",
          "label": "t:options.page"
        },
        {
          "value": "full",
          "label": "t:options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:names.video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "info": "Upload an MP4 or WebM file."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.video_autoplay",
      "info": "t:info.video_autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.video_loop",
      "default": true
    },
    {
      "type": "header",
      "content": "t:names.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "info": "The button shows only when both a label and a link are set."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "Bounce two column video",
      "settings": {
        "button_label": "Acquista Bounce"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "no-sugar",
            "text": "Senza zuccheri"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "no-sweeteners",
            "text": "Senza edulcoranti"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "no-gluten",
            "text": "Senza glutine"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "no-calories",
            "text": "Senza calorie"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "no-carbs",
            "text": "Senza carboidrati"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "no-artificial-flavours",
            "text": "Senza aromi artificiali"
          }
        }
      ]
    }
  ]
}
{% endschema %}
