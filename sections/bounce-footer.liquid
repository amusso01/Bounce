{%- comment -%}
  Bounce footer, three rows: the tagline on the left with the menu, IT | EN switcher and the
  Acquista button on the right; the logo across the full content width; then the year and
  company name on the left and "All rights reserved" on the right. No blocks on purpose:
  everything is set from the section settings. Each element fades up on its own, top left to
  bottom right (Animation settings); the background stays put. Styles live in
  src/scss/sections/_footer.scss.
{%- endcomment -%}

{% liquid
  render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id

  assign logo = settings.logo
  if section.settings.inverse_logo and settings.logo_inverse != blank
    assign logo = settings.logo_inverse
  endif
  assign logo_alt = 'accessibility.home_logo_alt' | t: store_name: shop.name
  assign logo_alt = logo.alt | default: logo_alt

  assign footer_menu = section.settings.menu

  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  # Fade cascade: the top row goes left to right, fade_step apart; the logo and the bottom
  # row start at set delays, and each element after them waits fade_step longer
  assign fade_step = 0.1
  assign fade_delay = 0
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div class="section section--page-width bounce-footer-section color-custom-{{ section.id }}">
  <div
    class="bounce-footer spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="bounce-footer__top">
      {%- if section.settings.tagline != blank -%}
        <p
          class="bounce-footer__tagline"
          {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
        >
          {{- section.settings.tagline | escape -}}
        </p>
      {%- endif -%}

      <div class="bounce-footer__nav">
        {%- if footer_menu.links.size > 0 -%}
          <nav aria-label="{{ footer_menu.title | escape }}">
            <ul class="bounce-footer__menu list-unstyled">
              {%- for link in footer_menu.links -%}
                {%- assign fade_delay = fade_delay | plus: fade_step -%}
                <li
                  class="bounce-footer__menu-item"
                  {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
                >
                  <a
                    href="{{ link.url }}"
                    class="bounce-footer__link"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if show_language -%}
          {%- assign fade_delay = fade_delay | plus: fade_step -%}
          <div
            class="bounce-footer__language"
            {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
          >
            {% render 'bounce-language-switcher', form_id: section.id %}
          </div>
        {%- endif -%}

        {%- assign fade_delay = fade_delay | plus: fade_step -%}
        {% render 'bounce-buy-button',
          link: section.settings.button_link,
          label: section.settings.button_label,
          class: 'button bounce-footer__button',
          fade_settings: section.settings,
          fade_delay: fade_delay
        %}
      </div>
    </div>

    {%- assign fade_delay = 0.3 -%}
    <a
      href="{{ routes.root_url }}"
      class="bounce-footer__logo"
      {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
    >
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 2240
          | image_tag:
            widths: '375, 750, 1120, 1500, 2240',
            sizes: '(min-width: 1200px) 1120px, 100vw',
            loading: 'lazy',
            alt: logo_alt,
            class: 'bounce-footer__logo-image'
        }}
      {%- else -%}
        <span class="bounce-footer__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <div class="bounce-footer__bottom">
      {%- assign fade_delay = 0.5 -%}
      <p
        class="bounce-footer__copyright"
        {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
      >
        {{- 'now' | date: '%Y' }} {{ section.settings.company_name | escape -}}
      </p>

      {%- assign fade_delay = fade_delay | plus: fade_step -%}
      <p
        class="bounce-footer__rights"
        {% render 'bounce-fade-attributes', settings: section.settings, delay: fade_delay %}
      >
        {{- 'bounce.footer.rights_reserved' | t -}}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bounce footer",
  "class": "section-wrapper",
  "limit": 1,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:settings.animation"
    },
    {
      "type": "checkbox",
      "id": "fade_up",
      "label": "Fade up on scroll",
      "info": "Each element fades in on its own, top left to bottom right. The background shows straight away.",
      "default": true
    },
    {
      "type": "range",
      "id": "fade_up_delay",
      "label": "Fade up delay",
      "info": "Seconds before the first element fades in.",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "unit": "s",
      "default": 0,
      "visible_if": "{{ section.settings.fade_up }}"
    },
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:settings.text",
      "default": "Less inside"
    },
    {
      "type": "header",
      "content": "t:content.menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:content.localization"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:settings.language_selector",
      "info": "t:info.manage_languages",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "info": "Leave blank to use the default: Acquista (IT), Buy now (EN). Shown in capitals."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link",
      "info": "The button is hidden until a link is set."
    },
    {
      "type": "header",
      "content": "t:content.logo"
    },
    {
      "type": "checkbox",
      "id": "inverse_logo",
      "label": "t:settings.use_inverse_logo",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "info": "Shown after the current year, which updates on its own.",
      "default": "Bounce SRLS"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Bounce footer"
    }
  ]
}
{% endschema %}
