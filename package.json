{
	"name": "bounce",
	"version": "1.0.0",
	"private": true,
	"author": "Andrea Musso <andrea.m@fdry.com>",
	"license": "MIT",
	"browserslist": "defaults and supports es6-module, ios_saf >= 16.4, safari >= 16.4",
	"scripts": {
		"dev": "parcel watch src/bounce.js src/bounce.scss --dist-dir assets --public-url ./",
		"dev:clean": "rm -rf .parcel-cache && pnpm dev",
		"build": "rm -f assets/*.map && parcel build src/bounce.js src/bounce.scss --dist-dir assets --public-url ./ --no-source-maps",
		"build:clean": "rm -rf .parcel-cache && pnpm build",
		"clean": "rm -rf .parcel-cache"
	},
	"dependencies": {
		"accordion-js": "^3.4.1",
		"arrive": "^2.5.3",
		"gsap": "^3.15.0",
		"include-media": "^2.0.0",
		"lenis": "^1.3.26",
		"swiper": "^14.1.0"
	},
	"devDependencies": {
		"@parcel/config-default": "2.16.4",
		"@parcel/transformer-css": "2.16.4",
		"@parcel/transformer-js": "2.16.4",
		"@parcel/transformer-sass": "2.16.4",
		"buffer": "^5.5.0||^6.0.0",
		"parcel": "^2.16.4",
		"process": "^0.11.10",
		"sass": "^1.102.0"
	}
}
