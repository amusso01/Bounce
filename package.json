{
	"name": "crashbaggage",
	"version": "1.0.0",
	"repository": "https://github.com/amusso01/Ground-Control",
	"author": "Andrea Musso <andrea.m@fdry.com>",
	"license": "MIT",
	"scripts": {
		"dev": "parcel watch src/bounce.js src/bounce.scss --dist-dir assets",
		"dev:clean": "rm -rf .parcel-cache && pnpm dev",
		"build": "parcel build src/bounce.js src/bounce.scss --dist-dir assets --no-source-maps && pnpm run minify-js",
		"build:clean": "rm -rf .parcel-cache && pnpm build",
		"clean": "rm -rf .parcel-cache",
		"minify-js": "terser assets/bounce.js -o assets/bounce.js --compress --mangle"
	},
	"dependencies": {
		"@babel/preset-env": "^7.29.7",
		"accordion-js": "^3.4.1",
		"arrive": "^2.5.3",
		"include-media": "^2.0.0",
		"parcel": "^2.16.4",
		"swiper": "^14.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@parcel/config-default": "2.16.4",
		"@parcel/transformer-css": "2.16.4",
		"@parcel/transformer-js": "2.16.4",
		"@parcel/transformer-sass": "2.16.4",
		"buffer": "^5.5.0||^6.0.0",
		"process": "^0.11.10",
		"sass": "^1.102.0",
		"terser": "^5.50.0"
	}
}
