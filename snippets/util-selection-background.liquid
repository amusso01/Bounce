{%- doc -%}
  Selection highlight background for a given text color: black when text is light
  (brightness >= 200), otherwise the theme accent (color palette color1 / bounce color 3).

  @param {color} color - Text color to match selection contrast against.

  @example
  {% capture selection_bg %}
    {% render 'util-selection-background', color: settings.page_text_color %}
  {% endcapture %}
{%- enddoc -%}

{%- liquid
  assign selection_text_brightness = color | color_brightness
  if selection_text_brightness >= 200
    echo '#000000'
  else
    echo settings.color_palette.color1
  endif
-%}
