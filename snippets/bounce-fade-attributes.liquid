{%- doc -%}
  Prints the attributes src/js/fade.js reads, from a block's Animation settings
  (fade_up, fade_up_duration). Prints nothing when they're off, or when the block has no
  such settings, so snippets shared with other blocks can render it unconditionally.

  Render it between two attributes that have quoted values: `{%- -%}` trimming next to a
  bare attribute glues the two together.

  @param {object} settings - The block's settings

  @example
  {% render 'bounce-fade-attributes', settings: block.settings %}
{%- enddoc -%}

{%- if settings.fade_up -%}
  data-fade-up
  {%- if settings.fade_up_duration > 0 %} data-fade-up-duration="{{ settings.fade_up_duration }}"{% endif -%}
{%- endif -%}
